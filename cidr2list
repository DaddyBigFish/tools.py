#!/usr/bin/env python3
import ipaddress,sys,os
split="--split" in sys.argv
args=[a for a in sys.argv[1:] if a!="--split"]
lines=[]
for a in args:
 lines.extend(open(a).readlines() if os.path.isfile(a) else [a])
if not args:lines=sys.stdin.readlines()
s=set()
for l in lines:
 l=l.strip()
 if not l:continue
 try:
  if '/' in l:
   n=ipaddress.IPv4Network(l,strict=False)
   if n.num_addresses>1<<20:print(f"skip {l} (too big)",file=sys.stderr);continue
   it=n.hosts() if n.num_addresses>2 else iter(n)
   s.update(map(str,it))
  else:s.add(str(ipaddress.IPv4Address(l)))
 except:print(f"bad: {l}",file=sys.stderr)
ips=sorted(s,key=ipaddress.IPv4Address)
if split:
 open("hosts","w").write("".join(i+"\n" for i in ips))
 d={}
 for i in ips:d.setdefault(i.rsplit('.',1)[0],[]).append(i)
 for k in sorted(d,key=lambda k:ipaddress.IPv4Address(k+'.0')):
  open(f"hosts_{k}.X","w").write("".join(i+"\n" for i in d[k]))
else:print("\n".join(ips))
